{
  "name": "hr-bot",
  "version": "0.1.0",
  "description": "HR Telegram bot — kompaniya/bo'lim/lavozim anketasi (uz/ru)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed-reset.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@grammyjs/conversations": "^1.2.0",
    "@grammyjs/i18n": "^1.1.0",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/storage-redis": "^2.5.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.45.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "grammy": "^1.32.0",
    "ioredis": "^5.4.1",
    "pdfmake": "^0.2.15",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
