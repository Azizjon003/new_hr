# Bot
BOT_TOKEN=salom
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Admins — faqat dastlabki bootstrap uchun (ixtiyoriy).
# Bot ishga tushganda bu ID dagi userlar DB ga isAdmin=true qilib seed qilinadi.
# Keyinchalik adminlarni /admin → 👤 Adminlar orqali boshqaring.
# Bo'sh qoldirsangiz, birinchi admin ni qo'lda DB da qo'yishingiz kerak (Prisma Studio).
ADMIN_IDS=6322528596

# Database
# Postgres credentials (docker-compose volume birinchi marta yaratilganda ishlatiladi)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=hr

# DOCKER uchun (server) — docker network ichidagi hostlar:
DATABASE_URL=postgresql://postgres:1234@postgres:5432/hr?schema=public
REDIS_URL=redis://redis:6379

# LOKAL DEV uchun (npm run dev, Windows) — yuqoridagilarni izohga olib, bularni yoqing:
# DATABASE_URL=postgresql://postgres:1234@localhost:5433/hr?schema=public
# REDIS_URL=redis://localhost:6379

# Files
FILES_DIR=./files
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# Sentry (ixtiyoriy)
SENTRY_DSN=
